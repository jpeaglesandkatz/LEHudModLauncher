    </PackageReference>
    <PackageReference Include="SharpCompress" Version="0.47.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DownloadLib\DownloadLib.csproj" />
    <ProjectReference Include="..\LogUtils\LogUtils.csproj" />
    <ProjectReference Include="..\SettingsManager\SettingsManager.csproj" />
  </ItemGroup>


</Project>
